# Pilih jaringan: sepolia (uji) atau base (mainnet)
NETWORK=sepolia

# Isi dengan URL Infura Anda (pakai API key BARU, jangan yang pernah dibagikan)
SEPOLIA_RPC=https://sepolia.infura.io/v3/<API_KEY_BARU>
BASE_RPC=https://base-mainnet.infura.io/v3/<API_KEY_BARU>

# Backend lokal (npm start): RPC di bawah dipakai server, tidak terlihat di browser
PORT=3000

# JANGAN commit file .env
LEAKED_PK=0x...
SPONSOR_PK=0x...      # dipakai backend (npm start) untuk membayar gas; pakai wallet khusus dengan ETH secukupnya

# ACTION: claim_transfer (call lalu kirim token) | transfer (token sudah di wallet) | custom (satu call saja)
ACTION=claim_transfer

SAFE=0x...
DELEGATE=0x...
TOKEN=0x...
CLAIM=0x...           # target contract (klaim/unstake/custom)
NATIVE_VALUE=0        # ETH yang dikirim bersama call (dari saldo wallet bocor)
CLAIM_DATA=0x...      # claim() kontrak uji = 0x4e71d92d ; airdrop asli: dari API/merkle proof
AMOUNT=all            # angka satuan token (mis. 100) atau "all" = seluruh saldo token

DRY_RUN=true          # false = kirim transaksi nyata
CONFIRM_MAINNET=no    # wajib "yes" untuk kirim di base
PRIORITY_FEE_WEI=10000000

# ---- Public mode (leave false for private use, no fee) ----
PUBLIC_MODE=false      # true = strict fee mode (requires the RescueFee contract; fee fixed at 20% in the contract)
MAX_GAS=700000         # gas cap per sponsored transaction
PUBLIC_HOST=           # e.g. rescue.example.com (behind a TLS reverse proxy)
BIND=127.0.0.1         # keep 127.0.0.1 when using a reverse proxy
TRUST_PROXY=false      # true only behind a trusted proxy (reads X-Forwarded-For)
